{
  "rules": {
    ".read": false,
    ".write": false,
    "usernames": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && newData.val() === auth.uid))",
        ".validate": "$name.matches(/^[a-z0-9_]{3,16}$/)"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": {
          ".write": "auth != null && auth.uid === $uid && (!data.exists() || newData.child('usernameKey').val() === data.child('usernameKey').val())",
          ".validate": "newData.hasChildren(['username','usernameKey','email','createdAt']) && newData.child('username').isString() && newData.child('username').val().length >= 3 && newData.child('username').val().length <= 16 && newData.child('usernameKey').isString() && root.child('usernames').child(newData.child('usernameKey').val()).val() === auth.uid"
        },
        "stats": { ".write": false },
        "history": { ".write": false },
        "appliedMatches": { ".write": false },
        "$other": { ".validate": false }
      }
    },
    "games": {
      "$code": {
        ".read": "auth != null && (data.child('playerAUid').val() === auth.uid || data.child('playerBUid').val() === auth.uid || root.child('openRooms').child($code).exists())",
        ".write": "auth != null && ((!data.exists() && newData.child('playerAUid').val() === auth.uid) || data.child('playerAUid').val() === auth.uid || data.child('playerBUid').val() === auth.uid || (!data.child('playerBUid').exists() && newData.child('playerBUid').val() === auth.uid))",
        ".validate": "!newData.exists() || (newData.child('roomCode').val() === $code && newData.child('playerAUid').isString())"
      }
    },
    "openRooms": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() === auth.uid || root.child('games').child($code).child('playerAUid').val() === auth.uid || root.child('games').child($code).child('playerBUid').val() === auth.uid)",
        "spectators": {
          "$session": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.child('uid').val() === auth.uid && newData.child('joinedAt').isNumber())"
          }
        }
      }
    },
    "tournaments": {
      ".read": "auth != null",
      ".write": false
    },
    "matches": {
      "$matchId": {
        ".read": "auth != null && (data.child('playerAUid').val() === auth.uid || data.child('playerBUid').val() === auth.uid)",
        ".write": false
      }
    }
  }
}
